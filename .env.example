# Переменные для serverless-функции api/order.js.
#
# Локально: скопируй этот файл в .env (он в .gitignore) и подставь значения —
# заработает при запуске через `npx vercel dev`.
#
# На проде: Vercel → Settings → Environment Variables (в репозиторий не коммитим).
#
# TELEGRAM_BOT_TOKEN — токен от @BotFather
# TELEGRAM_CHAT_ID   — id чата, куда бот шлёт заказы. Чтобы узнать: напиши боту
#                      любое сообщение и открой
#                      https://api.telegram.org/bot<ТОКЕН>/getUpdates
#                      нужное значение лежит в result[0].message.chat.id

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
